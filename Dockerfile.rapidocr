FROM python:3.11-slim@sha256:a630a63cdb314e2d138a2fca3e375e319e8568346ffafac5b980f888630ac4f1

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      libglib2.0-0 \
      libgl1 && \
    rm -rf /var/lib/apt/lists/*

# rapidocr core + onnxruntime engine. Install onnxruntime explicitly: the
# rapidocr[onnxruntime] extra does not reliably pull it in. PP-OCRv6 default
# models are downloaded lazily on first run.
RUN pip install --no-cache-dir \
      rapidocr \
      onnxruntime \
      openvino \
      pymupdf==1.24.10 \
      Pillow==11.3.0 \
      fastapi==0.136.1 \
      uvicorn==0.46.0 \
      python-multipart==0.0.27

# Pre-bake all three PP-OCRv6 tiers (tiny/small/medium det+rec, plus the
# shared cls model) into the image so runtime tier switching never waits on
# model downloads — a switch just loads engines from disk. Models land in
# site-packages/rapidocr/models. Falls back to lazy download when the build
# host can't reach modelscope.
RUN python -c "from rapidocr import ModelType, RapidOCR; [RapidOCR(params={'Det.model_type': t, 'Rec.model_type': t}) for t in (ModelType.TINY, ModelType.SMALL, ModelType.MEDIUM)]" \
      || echo "model prefetch skipped; will download lazily at runtime"

WORKDIR /app
COPY rapidocr_adapter.py /app/rapidocr_adapter.py

EXPOSE 8080
CMD ["uvicorn", "rapidocr_adapter:app", "--host", "0.0.0.0", "--port", "8080"]
