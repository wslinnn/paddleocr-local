FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      libglib2.0-0 \
      libgl1 && \
    rm -rf /var/lib/apt/lists/*

# rapidocr core + onnxruntime engine. Install onnxruntime explicitly: the
# rapidocr[onnxruntime] extra does not reliably pull it in.
RUN pip install --no-cache-dir \
      rapidocr \
      onnxruntime \
      pymupdf==1.24.10 \
      Pillow==11.3.0 \
      fastapi==0.136.1 \
      uvicorn==0.46.0 \
      python-multipart==0.0.27

# Pre-download the default medium models into the image so first inference is
# hot (no download latency / gateway timeout). Falls back to lazy download if
# the build environment has no network.
RUN python -c "from rapidocr import ModelType, RapidOCR; RapidOCR(params={'Det.model_type':ModelType.MEDIUM,'Rec.model_type':ModelType.MEDIUM})" || echo "model prefetch skipped"

WORKDIR /app
COPY rapidocr_adapter.py /app/rapidocr_adapter.py

EXPOSE 8080
CMD ["uvicorn", "rapidocr_adapter:app", "--host", "0.0.0.0", "--port", "8080"]
